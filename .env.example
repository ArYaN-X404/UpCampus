# UpCampus Environment Configuration

# Google AI Studio / Gemini API key for Gemma 4 multimodal triage inference
# Optional: If omitted or unconfigured, UpCampus operates seamlessly via its built-in local heuristic engine.
GEMINI_API_KEY=your_gemini_or_gemma_api_key_here

# Supabase Realtime Configuration (Optional for cloud sync; demo runs locally with built-in store)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
